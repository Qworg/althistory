# Server Configuration
PORT=3000
NODE_ENV=development

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Performance Configuration
QUERY_TIMEOUT_MS=2000
MAX_QUERY_RESULTS=10000
CACHE_EXPIRATION_MS=300000

# Local Execution Configuration
LOCAL_EXECUTION_ENABLED=false
LOCAL_DATA_DIR=./data
LOCAL_GRAPH_FILE=graph.json
LOCAL_CACHE_SIZE=1000
LOCAL_PERSISTENCE_INTERVAL=30000
LOCAL_BACKUP_ENABLED=true
LOCAL_BACKUP_INTERVAL=300000
LOCAL_MAX_MEMORY_MB=512

# Test Database Configuration (optional - defaults to main config if not set)
NEO4J_TEST_URI=bolt://localhost:7687
NEO4J_TEST_USERNAME=neo4j
NEO4J_TEST_PASSWORD=password
NEO4J_TEST_DATABASE=test
REDIS_TEST_HOST=localhost
REDIS_TEST_PORT=6379
REDIS_TEST_PASSWORD=

# API Key Authentication Configuration
# Set this to use a specific admin API key (auto-generated if not set)
# ADMIN_API_KEY=your_admin_api_key_here

# Rate Limiting Configuration (defaults shown)
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# RATE_LIMIT_REQUESTS_PER_HOUR=1000
# RATE_LIMIT_REQUESTS_PER_DAY=10000
# RATE_LIMIT_BATCH_SIZE=1000
# RATE_LIMIT_CONCURRENT_STREAMS=5