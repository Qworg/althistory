{
  "name": "hierarchical-temporal-graph",
  "version": "1.0.0",
  "description": "A system for capturing and analyzing historical events across multiple temporal scales",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "cors": "^2.8.5",
    "cytoscape": "^3.33.0",
    "cytoscape-dom-node": "^1.2.0",
    "d3": "^7.9.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "neo4j-driver": "^5.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "redis": "^4.6.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.54.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "vite": "^7.0.6",
    "vitest": "^1.0.4"
  },
  "keywords": [
    "temporal",
    "graph",
    "history",
    "neo4j",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
