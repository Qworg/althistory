{
  // The strictest union of the two consumers' settings: the backend compiles
  // this source as CommonJS (tsconfig.build.json), and the frontend type-checks
  // it in place under its own flags (noUncheckedIndexedAccess, noUnused*), so
  // it has to satisfy both.
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts"]
}
