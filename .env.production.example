# Production configuration for the Althistory docker-compose stack.
#
#   cp .env.production.example .env
#   edit the secrets below, then: docker compose up -d --build
#
# Nothing here is a real secret. Replace every CHANGE_ME value before deploying:
# the API refuses to start while one is still a CHANGE_ME placeholder.

# --- Neo4j -----------------------------------------------------------------
# The password is required (compose refuses to start without it). Neo4j 5
# enforces a minimum length of 8 characters.
NEO4J_PASSWORD=CHANGE_ME_strong_neo4j_password
# Compose sets these two on the service; they are listed here so that a bare
# `npm start` in cloud mode works from this file too (the API refuses to start
# when either is missing).
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M

# --- Redis -----------------------------------------------------------------
# Leave blank for no password (fine only on a private network).
# `localhost` is right for a bare process; compose overrides it to `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- API -------------------------------------------------------------------
NODE_ENV=production
PORT=3000
QUERY_TIMEOUT_MS=2000

# Graph metadata, export/import jobs, graph versions and API keys are files
# under LOCAL_DATA_DIR (they are per process, not shared between replicas), and
# the rate-limit counters are per process too. The stack is therefore ONE
# replica with a volume that outlives the container. This variable is the
# acknowledgement `validateConfig` requires in cloud mode; without it the API
# refuses to start. See docs/production-deployment.md §4.
LOCAL_EXECUTION_ENABLED=false
CLOUD_SINGLE_REPLICA_STATE=true
LOCAL_DATA_DIR=/data

# `/api/events`, `/api/arcs`, `/api/causal`, `/api/temporal` and
# `/api/inference` require an API key with the matching read:*/write:*
# permission. True is the default; it is written here so the deployment does
# not rely on the default. Set it false only for a deployment that is
# deliberately anonymous (a test rig, a firewall-only box).
API_AUTH_REQUIRED=true

# Trusted as an admin key on first start. Leave blank and the API generates one,
# logging it and writing /data/keys/admin-key.txt inside the api container:
#   docker compose exec api cat /data/keys/admin-key.txt
# Use the admin key to create the narrower keys the UI and agents should use.
ADMIN_API_KEY=

# The key the bundled SPA sends. It is a BUILD argument: baked into the
# JavaScript, so PUBLIC to anyone who can load the page. There is no key-entry
# screen (see docs/api-integration.md). Leave blank and the UI gets 401 from
# every entity route. Rebuild the web image after changing it:
#
#   docker compose exec -T api cat /data/keys/admin-key.txt   # after first start
#   # create a read-only key with it, then set this line to that key -- do NOT
#   # append a second VITE_API_KEY, the last one wins and it is easy to end up
#   # with the admin key in effect by accident.
#   docker compose build web && docker compose up -d web
#
# Use a key created from the admin key with only the permissions the UI needs
# (read:events, read:arcs, read:relationships, read:graphs) rather than the
# admin key itself: the admin key manages other keys, and this value is handed
# to every visitor. See docs/production-deployment.md §1.
VITE_API_KEY=
# Only consulted by non-browser clients; the bundled UI is same-origin through
# Caddy. Set it to your public origin if an agent talks to the API directly.
CORS_ORIGIN=*

# --- Web / reverse proxy ---------------------------------------------------
# Host port the SPA is published on.
WEB_PORT=8080
# Caddy site address. ":80" serves plain HTTP. Set a hostname (e.g.
# "althistory.example.ts.net") to have Caddy provision TLS automatically, or
# ":443" when TLS terminates upstream (a Tailscale sidecar, a cloud LB, ...).
CADDY_SITE_ADDRESS=:80
