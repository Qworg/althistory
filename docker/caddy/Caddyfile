# Caddy site for the Althistory web image.
#
# Serves the compiled SPA and proxies the API on the same origin, so the browser
# never makes a cross-origin request and no CORS configuration is needed for the
# bundled UI. WebSocket upgrades under /api/ (the stream endpoint is
# /api/ws/stream) are forwarded transparently by reverse_proxy.
#
# `handle` blocks are used instead of bare directives on purpose: Caddy orders
# `try_files` before `reverse_proxy`, so a top-level `try_files {path}
# /index.html` would rewrite /api/* to the SPA before the proxy ever matched.
# Mutually-exclusive handles evaluate in source order and avoid that entirely.
#
# {$CADDY_SITE_ADDRESS} defaults to :80. Set it to a hostname (e.g.
# "althistory.example.ts.net") to have Caddy obtain TLS automatically, or to
# ":443" when TLS is terminated upstream.

{$CADDY_SITE_ADDRESS::80} {
	encode zstd gzip

	# The API refuses bodies over 10 MB itself; this stops larger ones at the edge.
	request_body {
		max_size 16MB
	}

	# Browsers ignore HSTS over plain HTTP, so it only takes effect once the
	# site is served over TLS. No Content-Security-Policy yet: the timeline and
	# causal-graph views set inline styles, so a policy needs testing first.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /health {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
