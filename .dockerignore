# Keep the Docker build context small and deterministic.

.git
.gitignore
.github

# Installed dependencies are rebuilt inside the image.
node_modules
**/node_modules

# Build output is produced inside the image.
dist
**/dist
build

# Local execution state must never enter an image.
data
**/data
**.log
coverage
**/coverage

# Local secrets and editor state. Env files must never enter an image: a
# developer's .env.local is a local override, and a baked-in copy is one more
# thing that can disagree with the container's settings.
.env
**/.env
**/.env.local
**/.env.*.local
.idea
.vscode
.DS_Store

# Test scratch space.
**/test-e2e-data-*
