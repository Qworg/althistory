export function useCreateCausalLink(options?: UseMutationOptions<CausalRelationship, APIError, { causeId: string; effectId: string; relationship: CausalRelationshipData }>) {
  const queryClient = useQueryClient()
  const { addCausalRelationship, addError } = useGlobalStore(state => ({
    addCausalRelationship: state.addCausalRelationship,
    addError: state.addError
  }))
  
  return useMutation({
    mutationFn: ({ causeId, effectId, relationship }) => apiClient.causal.createLink(causeId, effectId, relationship),
    onSuccess: (newRelationship) => {
      // Update local state
      addCausalRelationship(newRelationship)
      
      // Invalidate causal relationships
      queryClient.invalidateQueries({ queryKey: queryKeys.causal.all })
    },
    onError: (error: APIError) => {
      addError({
        message: `Failed to create causal link: ${error.message}`,
        type: error.status === 400 ? 'validation' : 'network'
      })
    },
    ...options
  })
}

// Inference hooks
export function useInferredPressures(arcId?: string, options?: UseQueryOptions<InferredPressure[], APIError>) {
  const addError = useGlobalStore(state => state.addError)
  
  return useQuery({
    queryKey: queryKeys.inference.pressures(arcId),
    queryFn: () => apiClient.inference.getPressures(arcId),
