      addError({
        message: `Failed to fetch inferred pressures: ${error.message}`,
        type: 'network'
      })
    },
    staleTime: 10 * 60 * 1000, // 10 minutes
    ...options
  })
}

// Graph copy hooks
export function useCopyGraph(options?: UseMutationOptions<CopyResult, APIError, { type: 'full' | 'timeRange' | 'filter'; targetName: string; timeRange?: TimeRange; filter?: EntityFilter }>) {
  const addError = useGlobalStore(state => state.addError)
  
  return useMutation({
    mutationFn: async ({ type, targetName, timeRange, filter }) => {
      switch (type) {
        case 'full':
          return apiClient.graph.copyFull(targetName)
        case 'timeRange':
          if (!timeRange) throw new Error('Time range is required for time range copy')
          return apiClient.graph.copyByTimeRange(timeRange, targetName)
        case 'filter':
          if (!filter) throw new Error('Filter is required for filtered copy')
          return apiClient.graph.copyByFilter(filter, targetName)
        default:
          throw new Error('Invalid copy type')
      }
    },
    onError: (error: APIError) => {
      addError({
        message: `Failed to copy graph: ${error.message}`,
        type: 'network'
      })
    },
    ...options
  })
}

export function useCopyStatus(copyId: string, options?: UseQueryOptions<CopyResult, APIError>) {
  const addError = useGlobalStore(state => state.addError)
  
  return useQuery({
    queryKey: queryKeys.graph.copyStatus(copyId),
    queryFn: () => apiClient.graph.getCopyStatus(copyId),
    enabled: !!copyId,
    refetchInterval: (data) => {
      // Poll every 2 seconds if copy is in progress
      return data?.status === 'in_progress' ? 2000 : false
    },
    onError: (error: APIError) => {
      addError({
        message: `Failed to fetch copy status: ${error.message}`,
        type: 'network'
      })
    },
    ...options
  })
}